#include "Base.xcconfig"

// Debug builds must never register the production identity with LaunchServices,
// TCC, UserDefaults or SMAppService. Reusing the public identifier from a
// DerivedData path can make macOS attribute Screen Recording permission to a
// disposable build instead of the installed Release app.
APP_BUNDLE_IDENTIFIER = io.github.ischeneycc.ushot.debug

ONLY_ACTIVE_ARCH = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
DEBUG_INFORMATION_FORMAT = dwarf
