// Public product identity. Changing the bundle identifier after release breaks
// update matching and may invalidate Screen Recording authorization.
PRODUCT_NAME = Ushot
APP_BUNDLE_IDENTIFIER = io.github.ischeneycc.ushot
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER)
MARKETING_VERSION = 0.1.5
CURRENT_PROJECT_VERSION = 6
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
SPARKLE_PUBLIC_ED_KEY = +zRL11/2yYePt5O+OetThnLGwyvAvFtPPXxiBBOTTjE=
SPARKLE_KEY_ACCOUNT = io.github.ischeneycc.ushot.20260806

MACOSX_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64
SUPPORTED_PLATFORMS = macosx
SWIFT_VERSION = 5.0
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = UshotApp/Info.plist
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_CODE_COVERAGE = NO
CLANG_COVERAGE_MAPPING = NO
SWIFT_EMIT_LOC_STRINGS = YES

// Optional machine-local signing metadata. Never commit this file.
#include? "Local.xcconfig"
